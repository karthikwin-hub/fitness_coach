rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /check-ins/{memberId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /voice-notes/{memberId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /broadcasts/{tenantId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
