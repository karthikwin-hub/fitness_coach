# Production secrets for /opt/fitness-coach/web/.env.local on the Oracle VM.
# Copy locally for builds: web/.env.production.local (NEXT_PUBLIC_* are baked into the bundle).
#
#   cp deploy/env.production.example web/.env.production.local   # local build
#   cp deploy/env.production.example /opt/fitness-coach/web/.env.local   # on VM

# --- PostgreSQL (docker-compose.prod.yml on VM) ---
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-24
DATABASE_URL=postgresql://fitness:change-me-use-openssl-rand-base64-24@127.0.0.1:5432/fitness_coach

# --- App ---
NODE_ENV=production
DEFAULT_TENANT_SLUG=abstrack
COACH_EMAILS=helna@abstrack.com

# --- Firebase client (abstrack-prod web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDvH5_SwsP_WELh4FBMk1B5IVtqXGFsLMs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=abstrack-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=abstrack-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=abstrack-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=484081226341
NEXT_PUBLIC_FIREBASE_APP_ID=1:484081226341:web:1b4a57b2eb6eb945e6ec8c

# --- Firebase Admin (Console → Service accounts → Generate new private key) ---
FIREBASE_PROJECT_ID=abstrack-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Integrations ---
NEXT_PUBLIC_CAL_COM_URL=https://cal.com/coach-helna/discovery
GEMINI_API_KEY=
# Google Calendar OAuth (coach sync; use the same calendar connected to Cal.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://abstrack.duckdns.org/api/coach/calendar/google/callback
# Generate with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- Plan delivery (email) ---
# Optional: without RESEND_API_KEY, emails dry-run (logged) so local/dev still works.
RESEND_API_KEY=
EMAIL_FROM=plans@abstrack.duckdns.org
# Public URL used in PDF/WhatsApp/email links (defaults to request origin)
APP_BASE_URL=https://abstrack.duckdns.org

# --- DuckDNS (optional — cron on VM keeps abstrack.duckdns.org pointed at this host) ---
DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=abstrack
